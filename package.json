{
  "name": "@s-h-a-d-o-w/serenade-driver",
  "version": "1.2.1",
  "description": "A library for cross-platform system automations.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-h-a-d-o-w/driver.git"
  },
  "author": "Andreas Opferkuch",
  "license": "MIT",
  "gypfile": true,
  "binary": {
    "napi_versions": [
      10
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "clean": "rm -rf dist build bin",
    "dev": "pnpm build && node-gyp rebuild",
    "install": "prebuild-install -r napi || node-gyp rebuild",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "prepack": "pnpm build",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "files": [
    "binding.gyp",
    "index.js",
    "index.d.ts",
    "src"
  ],
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.8.0",
    "prebuild-install": "^7.1.3",
    "windows-shortcuts": "^0.1.6"
  },
  "devDependencies": {
    "@types/bindings": "^1.5.5",
    "@types/node": "^24.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "node-gyp": "^13.0.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "prebuild": "^13.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
